{
  // Cloudflare Workers: the built game (./dist) plus the room server. "name" must match the Worker in the dashboard.
  "name": "dungeon-maker",
  "compatibility_date": "2026-11-14",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist"
  },
  // One Durable Object per room code (SQLite-backed: the kind the free plan allows; state is kept in memory).
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
